#!/usr/bin/env python3
"""llm-bench - quick single-user benchmark for an OpenAI-compatible LLM server.

Measures, per case: time to first token (TTFT), prefill tok/s, decode tok/s,
for code vs prose output at several context depths, cold vs warm prompt cache,
plus a tool-call round trip. Stdlib only.

  llm-bench [--url http://172.18.0.50:8731/v1] [--model halogen-qwen3.8-flash-next]
            [--ctx 1000,32000,128000] [--max-tokens 400] [--json out.json]
"""
import argparse
import json
import random
import sys
import time
import urllib.request

CODE_TASK = ("Write a Python module implementing an LRU cache class with get, put, "
             "and resize methods, full type hints and docstrings, then pytest tests for it. "
             "Output only code.")
PROSE_TASK = ("Write an essay of several paragraphs on the history of time-sharing operating "
              "systems and how their ideas show up in modern cloud computing.")
WORDS = ("kernel scheduler page table interrupt socket buffer daemon process thread mutex "
         "inode filesystem journal checksum packet route gateway latency throughput cache "
         "register pipeline branch vector tensor shard replica quorum lease token").split()


def filler(n_tokens, seed):
    """~n_tokens of deterministic filler (roughly 1.3 tokens per word)."""
    rng = random.Random(seed)
    words = [rng.choice(WORDS) for _ in range(int(n_tokens / 1.3))]
    lines = [" ".join(words[i:i + 16]) for i in range(0, len(words), 16)]
    return "\n".join(lines)


def stream_chat(url, model, messages, max_tokens, tools=None):
    body = {"model": model, "messages": messages, "max_tokens": max_tokens,
            "temperature": 0, "stream": True, "stream_options": {"include_usage": True}}
    if tools:
        body["tools"] = tools
    req = urllib.request.Request(url + "/chat/completions", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json",
                                          "Authorization": "Bearer none"})
    t0 = time.monotonic()
    ttft = None
    n_chunks = 0
    usage = {}
    tool_calls = {}
    text = []
    with urllib.request.urlopen(req, timeout=3600) as resp:
        for raw in resp:
            line = raw.decode().strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            ev = json.loads(data)
            if ev.get("usage"):
                usage = ev["usage"]
            for ch in ev.get("choices", []):
                d = ch.get("delta", {})
                piece = d.get("content") or d.get("reasoning_content") or ""
                for tc in d.get("tool_calls") or []:
                    slot = tool_calls.setdefault(tc.get("index", 0), {"name": "", "args": ""})
                    fn = tc.get("function", {})
                    slot["name"] += fn.get("name") or ""
                    slot["args"] += fn.get("arguments") or ""
                    piece = piece or "."
                if piece:
                    if ttft is None:
                        ttft = time.monotonic() - t0
                    n_chunks += 1
                    text.append(d.get("content") or "")
    total = time.monotonic() - t0
    return {"ttft": ttft or total, "total": total, "chunks": n_chunks, "usage": usage,
            "tool_calls": list(tool_calls.values()), "text": "".join(text)}


def run_case(url, model, kind, ctx, max_tokens, seed):
    task = CODE_TASK if kind == "code" else PROSE_TASK
    prefix = filler(ctx, seed) if ctx > 0 else ""
    msgs = [{"role": "system", "content": "You are a concise expert assistant. Answer directly."}]
    if prefix:
        msgs.append({"role": "user", "content": "Reference notes (ignore unless relevant):\n" + prefix})
        msgs.append({"role": "assistant", "content": "Noted."})
    msgs.append({"role": "user", "content": task})
    r = stream_chat(url, model, msgs, max_tokens)
    u = r["usage"]
    p_tok = u.get("prompt_tokens") or ctx
    c_tok = u.get("completion_tokens") or r["chunks"]
    decode_s = max(r["total"] - r["ttft"], 1e-6)
    return {"kind": kind, "ctx_target": ctx, "prompt_tokens": p_tok, "completion_tokens": c_tok,
            "ttft_s": round(r["ttft"], 2), "prefill_tps": round(p_tok / max(r["ttft"], 1e-6), 1),
            "decode_tps": round(max(c_tok - 1, 1) / decode_s, 1), "total_s": round(r["total"], 2)}


def tool_check(url, model):
    tools = [{"type": "function", "function": {
        "name": "get_weather", "description": "Get current weather for a city",
        "parameters": {"type": "object", "properties": {"city": {"type": "string"}},
                       "required": ["city"]}}}]
    msgs = [{"role": "user", "content": "What's the weather in Lisbon right now? Use the tool."}]
    r = stream_chat(url, model, msgs, 256, tools=tools)
    ok = False
    detail = "no tool call"
    if r["tool_calls"]:
        call = r["tool_calls"][0]
        try:
            args = json.loads(call["args"] or "{}")
            ok = call["name"] == "get_weather" and "lisbon" in str(args.get("city", "")).lower()
            detail = f'{call["name"]}({args})'
        except json.JSONDecodeError:
            detail = f'bad JSON args: {call["args"][:80]!r}'
    return {"tool_call_ok": ok, "detail": detail, "ttft_s": round(r["ttft"], 2)}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--url", default="http://172.18.0.50:8731/v1")
    ap.add_argument("--model", default="halogen-qwen3.8-flash-next")
    ap.add_argument("--ctx", default="1000,32000,128000", help="comma-separated context sizes")
    ap.add_argument("--max-tokens", type=int, default=400)
    ap.add_argument("--json", help="also write results to this file")
    a = ap.parse_args()

    rows = []
    print(f"{'case':<26}{'prompt':>8}{'gen':>6}{'TTFT s':>9}{'prefill/s':>11}{'decode/s':>10}")
    for ctx in [int(c) for c in a.ctx.split(",")]:
        for kind in ("code", "prose"):
            seed = ctx * 7 + (1 if kind == "code" else 2)
            for phase in ("cold", "warm"):
                r = run_case(a.url, a.model, kind, ctx, a.max_tokens, seed)
                r["cache"] = phase
                rows.append(r)
                label = f"{kind} ctx={ctx} {phase}"
                print(f"{label:<26}{r['prompt_tokens']:>8}{r['completion_tokens']:>6}"
                      f"{r['ttft_s']:>9}{r['prefill_tps']:>11}{r['decode_tps']:>10}", flush=True)
    tc = tool_check(a.url, a.model)
    print(f"\ntool call: {'OK' if tc['tool_call_ok'] else 'FAIL'} - {tc['detail']} (TTFT {tc['ttft_s']}s)")
    if a.json:
        with open(a.json, "w") as f:
            json.dump({"cases": rows, "tool_call": tc}, f, indent=2)
    return 0 if tc["tool_call_ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
