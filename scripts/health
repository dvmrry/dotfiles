#!/bin/sh
echo "=== Uptime ==="
uptime

printf "\n%s\n" "=== Disk Usage ==="
df -H / /nix

printf "\n%s\n" "=== Memory Pressure ==="
memory_pressure | head -3

printf "\n%s\n" "=== Nix Store ==="
du -sh /nix/store 2>/dev/null

printf "\n%s\n" "=== Power Management ==="
pmset -g | grep -E 'sleep|standby|autopoweroff'

printf "\n%s\n" "=== Recent Wake/Sleep ==="
pmset -g log 2>/dev/null | grep -E "Wake|Sleep" | tail -5

printf "\n%s\n" "=== SSH Sessions ==="
who

printf "\n%s\n" "=== tmux Sessions ==="
tmux list-sessions 2>/dev/null || echo "No tmux sessions"
